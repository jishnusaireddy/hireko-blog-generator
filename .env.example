# ==============================================================================
# Hireko.ai Blog Generator — Environment Variables
# ==============================================================================
# Copy this file to .env for local development, or set these
# as Environment Variables in Railway.app Dashboard → Variables tab.
# ==============================================================================

# LLM Provider Configuration
# Supported: openrouter, nvidia, groq
LLM_PROVIDER=openrouter
LLM_MODEL=qwen/qwen3.7-flash

# OpenRouter API Key (get from: https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Serper Web Search API Key (get from: https://serper.dev)
# Optional but recommended for live research
SERPER_API_KEY=your-serper-key-here

# --- Alternative LLM Providers (uncomment one set) ---

# NVIDIA NIM (get from: https://build.nvidia.com)
# LLM_PROVIDER=nvidia
# LLM_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_API_KEY=nvapi-your-key-here

# Groq (get from: https://console.groq.com)
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=gsk_your-key-here
